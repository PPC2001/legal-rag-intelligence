# ──────────────────────────────────────────────────────────────
# Legal RAG QA — Environment Configuration Template
# Copy to .env and fill in real values.
# ──────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
ENV=DEV
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="Legal RAG QA"

# ── Database (Neon PostgreSQL + pgvector) ────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── LLM Configuration ───────────────────────────────────────
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1000

# ── API Keys (set only the providers you use) ────────────────
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── Embedding ────────────────────────────────────────────────
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# ── Retrieval ────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
SIMILARITY_THRESHOLD=0.3

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1
CORS_ORIGINS=["*"]

# ── Upload & Storage ─────────────────────────────────────────
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=50
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_in_production
S3_BUCKET_NAME=legal-documents
S3_REGION=us-east-1

# ── Scalability (Celery, Redis, Reranker) ─────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
SPARSE_SEARCH_BACKEND=postgres
ENABLE_RERANKER=true
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_TOP_K=5
ENABLE_SEMANTIC_CACHE=true
CACHE_SIMILARITY_THRESHOLD=0.96
CACHE_TTL_SECONDS=86400

# ── Observability (Langfuse) ─────────────────────────────────
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SECRET=change_me_in_production_min_32_chars
LANGFUSE_SALT=change_me_in_production_min_32_chars

# ── Local Docker PostgreSQL Auth ──────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=legal_rag


